# ---- LageKatSe server configuration ----

# HTTP/WebSocket port for the backend
PORT=8080

# Secret used to sign session tokens (JWT). CHANGE THIS in any real deployment.
JWT_SECRET=dev-only-change-me

# Persistence:
#   - leave DATABASE_URL empty  -> in-memory store (no durability; fine for dev)
#   - set it to a Postgres URL   -> durable persistence (snapshots + update log)
DATABASE_URL=
# DATABASE_URL=postgres://lagekatse:lagekatse@localhost:5432/lagekatse

# Allowed origin of the web app (CORS). Vite dev server defaults to 5173.
CORS_ORIGIN=http://localhost:5173

# ---- web (Vite) ----
# Base URL the browser uses to reach the backend. Injected at build/dev time.
VITE_API_URL=http://localhost:8080
