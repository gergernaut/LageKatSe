# LageKatSe configuration.
# Copy this file to ".env" IN THIS DIRECTORY (the repo root):
#     cp .env.example .env
# The backend loads it via dotenv; Vite loads the VITE_* vars from the same file.
# Values are read ONCE at startup — restart `pnpm dev` after changing them
# (and re-run `pnpm build` for a production web build, where VITE_* is baked in).

# ---- backend ----

# HTTP/WebSocket port for the backend.
PORT=8080

# Secret used to sign session tokens (JWT). CHANGE THIS in any real deployment.
JWT_SECRET=dev-only-change-me

# Persistence:
#   empty        -> in-memory store (no durability; fine for local dev)
#   Postgres URL -> durable persistence (snapshots + update log)
DATABASE_URL=
# DATABASE_URL=postgres://lagekatse:lagekatse@localhost:5432/lagekatse

# Origin the BROWSER uses to open the web app, for CORS. Must match where you
# actually open it. Local: http://localhost:5173. Behind a reverse-proxy with
# same-origin routing: irrelevant (CORS check does not trigger), but set it to
# the external URL (https://<DOMAIN>) to be safe. A mismatch makes the browser
# block API calls.
CORS_ORIGIN=http://localhost:5173

# Rate-Limiting (Brute-Force-/Enumeration-Schutz). Fenster gilt pro Client-IP.
#   RATE_LIMIT_MAX            globales Limit pro Fenster (alle Endpunkte)
#   RATE_LIMIT_SENSITIVE_MAX  strengeres Limit für Lobby-Join & Raum-Anlegen
#   RATE_LIMIT_WINDOW_MS      Fenstergröße in Millisekunden
RATE_LIMIT_MAX=300
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Läuft der Server hinter einem Reverse-Proxy (TLS-Terminierung)? Dann "true"
# setzen, damit die echte Client-IP (X-Forwarded-For) fürs Rate-Limit zählt —
# sonst landen alle Anfragen auf der Proxy-IP. Nur hinter vertrauenswürdigem Proxy!
TRUST_PROXY=false

# Automatische Inaktivitäts-Retention (E10/#66). Räume deren last_active_at
# älter als die Frist ist, werden periodisch per Cascade-DELETE gelöscht.
#   RETENTION_DAYS         Frist in Tagen (Default 28 = 4 Wochen, #73)
#   RETENTION_INTERVAL_MS  Intervall des Cleanup-Sweeps in ms (Default 86400000 = 24 h)
RETENTION_DAYS=28
RETENTION_INTERVAL_MS=86400000

# ---- frontend (Vite — only VITE_* vars are exposed to the browser) ----

# URL the BROWSER uses to reach the backend. Empty (default) = same-origin
# (API served by the reverse-proxy alongside the SPA — production/pilot).
# For dev or split deployments, set to the backend URL, e.g.
# http://localhost:8080 (dev) or http://192.168.1.50:8080 (LAN).
VITE_API_URL=

# Grundkarten-Kacheln (#96). Leer (Default) = OSM-Public. Für einen eigenen
# Tile-Server das Leaflet-Template setzen, z. B.
# http://tiles.lan/tile/{z}/{x}/{y}.png
# Hinweis: VITE_* wird zur BUILD-Zeit gebacken. Soll dasselbe Image mehrere
# Umgebungen (LAN/Internet/offline) bedienen, stattdessen zur Laufzeit in
# packages/web/public/config.js (window.__LAGEKATSE_CONFIG__.tileUrl) setzen —
# die Laufzeit-Konfig hat Vorrang und braucht keinen Neu-Build.
VITE_TILE_URL=

# ---- docker-compose deployment (reverse-proxy + TLS, #65) ----

# Welche GHCR-Image-Version docker-compose zieht (#99). Leer/ungesetzt = latest.
# Für den Ernstfall auf eine feste Version pinnen, z.B. 1.2.3.
# LAGEKATSE_IMAGE_TAG=latest

# Public hostname for the reverse proxy (Caddy). Required for Let's-Encrypt.
# Example: lagekatse.example.org
DOMAIN=

# Email for Let's-Encrypt certificate notifications (optional but recommended).
CADDY_EMAIL=

# Postgres password (change from default for any real deployment!).
POSTGRES_PASSWORD=lagekatse
