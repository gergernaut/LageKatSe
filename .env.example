# LageKatSe-Konfiguration.
#
# Diese Datei bedient ZWEI Modi — jeder Abschnitt ist entsprechend markiert:
#   (DEV)    `pnpm dev`  — das Backend liest sie via dotenv, Vite liest VITE_* vars.
#   (DOCKER) `docker compose up` — docker-compose.yml interpoliert nur die Variablen
#            im Abschnitt „docker-compose deployment“ weiter unten; alles andere
#            wird dort festgesetzt und NICHT aus dieser Datei gelesen.
#
# Kopieren nach „.env“ im Repo-Root:  cp .env.example .env
# Werte werden EINMAL beim Start gelesen — nach Änderung neu starten.

# ============ (DEV) Backend ============
# Im Docker-Betrieb nicht verwendet — docker-compose.yml setzt diese direkt.

# HTTP/WebSocket-Port für das Backend.
PORT=8080

# Secret zum Signieren der Session-Token (JWT). In jedem echten Einsatz ändern!
JWT_SECRET=dev-only-change-me

# Persistenz:
#   leer        -> In-Memory-Store (keine Persistenz; für lokales Dev ausreichend)
#   Postgres-URL -> dauerhafte Persistenz (Snapshots + Update-Log)
DATABASE_URL=
# DATABASE_URL=postgres://lagekatse:***@localhost:5432/lagekatse

# Origin, die der BROWSER nutzt, um die Web-App zu öffnen (für CORS). Muss
# dorthin passen, wo sie tatsächlich geöffnet wird. Lokal: http://localhost:5173.
# Hinter einem Reverse-Proxy mit Same-Origin-Routing: irrelevant (CORS-Check
# greift nicht), aber sicherheitshalber auf die externe URL (https://<DOMAIN>)
# setzen. Bei Mismatch blockt der Browser die API-Calls.
CORS_ORIGIN=http://localhost:5173

# Rate-Limiting (Brute-Force-/Enumeration-Schutz). Fenster gilt pro Client-IP.
#   RATE_LIMIT_MAX            globales Limit pro Fenster (alle Endpunkte)
#   RATE_LIMIT_SENSITIVE_MAX  strengeres Limit für Lobby-Join & Raum-Anlegen
#   RATE_LIMIT_WINDOW_MS      Fenstergröße in Millisekunden
RATE_LIMIT_MAX=300
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Läuft der Server hinter einem Reverse-Proxy (TLS-Terminierung)? Dann „true“
# setzen, damit die echte Client-IP (X-Forwarded-For) fürs Rate-Limit zählt —
# sonst landen alle Anfragen auf der Proxy-IP. Nur hinter vertrauenswürdigem Proxy!
# (Docker: docker-compose.yml setzt dies bereits auf „true“ — hier nicht ändern.)
TRUST_PROXY=false

# Automatische Inaktivitäts-Retention (E10/#66). Räume deren last_active_at
# älter als die Frist ist, werden periodisch per Cascade-DELETE gelöscht.
#   RETENTION_DAYS         Frist in Tagen (Default 28 = 4 Wochen, #73)
#   RETENTION_INTERVAL_MS  Intervall des Cleanup-Sweeps in ms (Default 86400000 = 24 h)
RETENTION_DAYS=28
RETENTION_INTERVAL_MS=86400000

# ============ (DEV) Frontend (Vite — nur VITE_* vars werden dem Browser ausgesetzt) ============
# Nur zur Build-Zeit. Im Docker-Betrieb wird das Web-Image mit Defaults gebaut
# und die Laufzeit-Konfiguration läuft über public/config.js (siehe
# config.js.example) — NICHT über diese Variablen.

# URL, die der BROWSER nutzt, um das Backend zu erreichen. Leer (Default) =
# Same-Origin (API wird vom Reverse-Proxy neben der SPA ausgeliefert — Produktion/Pilot).
# Für Dev oder Split-Deployments auf die Backend-URL setzen, z. B.
# http://localhost:8080 (Dev) oder http://192.168.1.50:8080 (LAN).
VITE_API_URL=

# Grundkarten-Kacheln (#96). Leer (Default) = OSM-Public. Für einen eigenen
# Tile-Server das Leaflet-Template setzen, z. B.
# http://tiles.lan/tile/{z}/{x}/{y}.png
# Hinweis: VITE_* wird zur BUILD-Zeit gebacken. Soll dasselbe Image mehrere
# Umgebungen (LAN/Internet/offline) bedienen, stattdessen zur Laufzeit in
# packages/web/public/config.js (window.__LAGEKATSE_CONFIG__.tileUrl) setzen —
# die Laufzeit-Konfig hat Vorrang und braucht keinen Neu-Build.
VITE_TILE_URL=

# ============ (DOCKER) docker-compose deployment (Reverse-Proxy + TLS, #65) ============
# Nur diese Variablen werden von docker-compose.yml per ${...} aus der .env
# interpoliert. Alles obige ist DEV-only und wird im Docker-Betrieb ignoriert.

# Secret zum Signieren der Session-Token (JWT). ERFORDERLICH — docker-compose.yml
# startet nicht ohne. Starkes, zufälliges Passwort verwenden.
JWT_SECRET=dev-only-change-me

# Öffentlicher Hostname für den Reverse-Proxy (Caddy). ERFORDERLICH für Let's-Encrypt.
# Beispiel: lagekatse.example.org  (:80 für plain HTTP / LAN ohne TLS)
DOMAIN=

# E-Mail für Let's-Encrypt-Zertifikatsbenachrichtigungen (optional, Default
# admin@example.org — nur relevant für TLS mit öffentlicher Domain).
CADDY_EMAIL=

# Postgres-Passwort (für jeden echten Einsatz vom Default ändern!).
POSTGRES_PASSWORD=lagekatse

# Welche GHCR-Image-Version docker-compose zieht (#99). Leer/ungesetzt = latest.
# Für den Ernstfall auf eine feste Version pinnen, z. B. 1.2.3.
# LAGEKATSE_IMAGE_TAG=latest

# CORS-Origin (optional, Default https://<DOMAIN>). Hinter dem Same-Origin-Proxy
# meist irrelevant, aber sicherheitshalber explizit setzen.
# CORS_ORIGIN=https://lagekatse.example.org