# Caddyfile for the web container (static SPA serving).
# Serves dist/ and falls back to index.html for client-side routing.
{
	log {
		level INFO
		output stdout
		format json {
			time_format rfc3339
		}
	}
}
:80 {
	root * /srv
	encode gzip zstd

	# Cache-Strategie:
	# - Gehashte Build-Assets (Vite legt sie unter /assets/ mit Content-Hash ab):
	#   ändern bei Änderung den Dateinamen → unbegrenzt cachebar (immutable).
	# - Taktische-Zeichen-Grafiken: stabile Namen, ändern sich praktisch nie
	#   → lange cachen (spart Traffic für die ~1000 SVGs), aber nicht "immutable".
	# - Alles andere (HTML-Shell, taktische-zeichen/index.json, config.js, favicon …):
	#   immer revalidieren (billiges 304 via ETag) → neue Builds/Symbole sofort sichtbar.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@symbols path /taktische-zeichen/svg/*
	header @symbols Cache-Control "public, max-age=604800"

	@revalidate {
		not path /assets/* /taktische-zeichen/svg/*
	}
	header @revalidate Cache-Control "no-cache"

	# Gehashte Build-Assets: fehlt eine Datei (veralteter Client fordert einen
	# Chunk aus einem alten Build an), liefert file_server einen echten 404 —
	# NICHT den SPA-Fallback. Sonst käme index.html (HTML) mit Status 200, und ein
	# dynamisches import() versucht, HTML als JS-Modul zu laden → kryptischer
	# TypeError statt eines klaren 404 (#201). Der Client heilt sich per
	# `vite:preloadError`-Reload (s. main.tsx).
	handle /assets/* {
		file_server
	}

	# Alles andere: SPA — client-seitiges Routing über index.html.
	handle {
		try_files {path} /index.html
		file_server
	}
}
